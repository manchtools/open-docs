<?xml version="1.0" encoding="UTF-8"?>
<!--
  Atom 1.0 (RFC 4287) RELAX NG schema: the normative grammar from the RFC,
  in XML syntax, used to validate open-docs' generated feeds against the spec
  with xmllint's relaxng mode. Element names are atom-prefixed (the Atom
  namespace); Atom attributes are unqualified (no namespace); only
  foreign-namespace attributes are accepted as extensions, so a stray
  no-namespace attribute is rejected.
-->
<grammar xmlns="http://relaxng.org/ns/structure/1.0"
         xmlns:atom="http://www.w3.org/2005/Atom"
         xmlns:xml="http://www.w3.org/XML/1998/namespace"
         datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">

  <start>
    <choice>
      <ref name="atomFeed"/>
      <ref name="atomEntry"/>
    </choice>
  </start>

  <define name="atomCommonAttributes">
    <optional><attribute name="xml:base"/></optional>
    <optional><attribute name="xml:lang"/></optional>
    <zeroOrMore>
      <attribute>
        <anyName>
          <except>
            <nsName ns=""/>
            <nsName ns="http://www.w3.org/2005/Atom"/>
          </except>
        </anyName>
      </attribute>
    </zeroOrMore>
  </define>

  <define name="anyElement">
    <element>
      <anyName/>
      <zeroOrMore>
        <choice>
          <attribute><anyName/></attribute>
          <text/>
          <ref name="anyElement"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="anyForeignElement">
    <element>
      <anyName><except><nsName ns="http://www.w3.org/2005/Atom"/></except></anyName>
      <zeroOrMore>
        <choice>
          <attribute><anyName/></attribute>
          <text/>
          <ref name="anyElement"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="undefinedContent">
    <zeroOrMore><choice><text/><ref name="anyForeignElement"/></choice></zeroOrMore>
  </define>

  <!-- Text constructs: text/html (plain text) or xhtml (a div) -->
  <define name="atomTextConstruct">
    <choice>
      <group>
        <optional><attribute name="type"><choice><value>text</value><value>html</value></choice></attribute></optional>
        <ref name="atomCommonAttributes"/>
        <text/>
      </group>
      <group>
        <attribute name="type"><value>xhtml</value></attribute>
        <ref name="atomCommonAttributes"/>
        <ref name="anyElement"/>
      </group>
    </choice>
  </define>

  <define name="atomTitle"><element name="atom:title"><ref name="atomTextConstruct"/></element></define>
  <define name="atomSummary"><element name="atom:summary"><ref name="atomTextConstruct"/></element></define>
  <define name="atomSubtitle"><element name="atom:subtitle"><ref name="atomTextConstruct"/></element></define>
  <define name="atomRights"><element name="atom:rights"><ref name="atomTextConstruct"/></element></define>

  <define name="atomDateConstruct">
    <ref name="atomCommonAttributes"/>
    <text/>
  </define>
  <define name="atomUpdated"><element name="atom:updated"><ref name="atomDateConstruct"/></element></define>
  <define name="atomPublished"><element name="atom:published"><ref name="atomDateConstruct"/></element></define>

  <define name="atomId"><element name="atom:id"><ref name="atomCommonAttributes"/><text/></element></define>
  <define name="atomIcon"><element name="atom:icon"><ref name="atomCommonAttributes"/><text/></element></define>
  <define name="atomLogo"><element name="atom:logo"><ref name="atomCommonAttributes"/><text/></element></define>

  <define name="atomPersonConstruct">
    <ref name="atomCommonAttributes"/>
    <interleave>
      <element name="atom:name"><text/></element>
      <optional><element name="atom:uri"><ref name="atomCommonAttributes"/><text/></element></optional>
      <optional><element name="atom:email"><text/></element></optional>
      <zeroOrMore><ref name="anyForeignElement"/></zeroOrMore>
    </interleave>
  </define>
  <define name="atomAuthor"><element name="atom:author"><ref name="atomPersonConstruct"/></element></define>
  <define name="atomContributor"><element name="atom:contributor"><ref name="atomPersonConstruct"/></element></define>

  <define name="atomLink">
    <element name="atom:link">
      <ref name="atomCommonAttributes"/>
      <attribute name="href"/>
      <optional><attribute name="rel"/></optional>
      <optional><attribute name="type"/></optional>
      <optional><attribute name="hreflang"/></optional>
      <optional><attribute name="title"/></optional>
      <optional><attribute name="length"/></optional>
      <ref name="undefinedContent"/>
    </element>
  </define>

  <define name="atomCategory">
    <element name="atom:category">
      <ref name="atomCommonAttributes"/>
      <attribute name="term"/>
      <optional><attribute name="scheme"/></optional>
      <optional><attribute name="label"/></optional>
      <ref name="undefinedContent"/>
    </element>
  </define>

  <define name="atomGenerator">
    <element name="atom:generator">
      <ref name="atomCommonAttributes"/>
      <optional><attribute name="uri"/></optional>
      <optional><attribute name="version"/></optional>
      <text/>
    </element>
  </define>

  <define name="atomContent">
    <element name="atom:content">
      <ref name="atomCommonAttributes"/>
      <optional><attribute name="type"/></optional>
      <optional><attribute name="src"/></optional>
      <ref name="undefinedContent"/>
    </element>
  </define>

  <define name="atomSource">
    <element name="atom:source">
      <ref name="atomCommonAttributes"/>
      <zeroOrMore>
        <choice>
          <ref name="atomAuthor"/><ref name="atomCategory"/><ref name="atomContributor"/>
          <ref name="atomGenerator"/><ref name="atomIcon"/><ref name="atomId"/>
          <ref name="atomLink"/><ref name="atomLogo"/><ref name="atomRights"/>
          <ref name="atomSubtitle"/><ref name="atomTitle"/><ref name="atomUpdated"/>
          <ref name="anyForeignElement"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="atomFeed">
    <element name="atom:feed">
      <ref name="atomCommonAttributes"/>
      <interleave>
        <ref name="atomId"/>
        <ref name="atomTitle"/>
        <ref name="atomUpdated"/>
        <zeroOrMore><ref name="atomAuthor"/></zeroOrMore>
        <zeroOrMore><ref name="atomCategory"/></zeroOrMore>
        <zeroOrMore><ref name="atomContributor"/></zeroOrMore>
        <optional><ref name="atomGenerator"/></optional>
        <optional><ref name="atomIcon"/></optional>
        <zeroOrMore><ref name="atomLink"/></zeroOrMore>
        <optional><ref name="atomLogo"/></optional>
        <optional><ref name="atomRights"/></optional>
        <optional><ref name="atomSubtitle"/></optional>
        <zeroOrMore><ref name="anyForeignElement"/></zeroOrMore>
        <zeroOrMore><ref name="atomEntry"/></zeroOrMore>
      </interleave>
    </element>
  </define>

  <define name="atomEntry">
    <element name="atom:entry">
      <ref name="atomCommonAttributes"/>
      <interleave>
        <ref name="atomId"/>
        <ref name="atomTitle"/>
        <ref name="atomUpdated"/>
        <optional><ref name="atomPublished"/></optional>
        <zeroOrMore><ref name="atomAuthor"/></zeroOrMore>
        <zeroOrMore><ref name="atomCategory"/></zeroOrMore>
        <optional><ref name="atomContent"/></optional>
        <zeroOrMore><ref name="atomContributor"/></zeroOrMore>
        <zeroOrMore><ref name="atomLink"/></zeroOrMore>
        <optional><ref name="atomRights"/></optional>
        <optional><ref name="atomSource"/></optional>
        <optional><ref name="atomSummary"/></optional>
        <zeroOrMore><ref name="anyForeignElement"/></zeroOrMore>
      </interleave>
    </element>
  </define>

</grammar>
